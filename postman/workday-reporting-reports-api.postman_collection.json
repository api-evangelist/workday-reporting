{
  "info": {
    "_postman_id": "34b5d919-c424-43b4-9baf-4df96ce18427",
    "name": "Workday Reporting Workday Report-as-a-Service (RaaS) Report Metadata Reports API",
    "description": "REST API for accessing Workday custom and standard reports as RESTful web services. Enables external systems to consume report data in JSON, CSV, or XML formats. Reports must be configured as Advanced type reports with web service enabled in Workday before they can be accessed through this API. Supports prompt-based filtering through query parameters matching report prompt names configured in the report definition.\n\nContact Support:\n Name: Workday Support\n Email: support@workday.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T03:32:12.000Z",
    "updatedAt": "2026-07-28T03:32:12.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-34b5d919-c424-43b4-9baf-4df96ce18427"
  },
