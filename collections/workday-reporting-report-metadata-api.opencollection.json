{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workday Reporting Workday Report-as-a-Service (RaaS) Report Metadata API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Report Metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Workday Reporting Get report field metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://wd2-impl-services1.workday.com/ccx/service/customreport2/{tenant}/:reportOwner/:reportName/fields",
            "params": [
              {
                "name": "reportOwner",
                "value": "",
                "type": "path",
                "description": "Username of the report owner"
              },
              {
                "name": "reportName",
                "value": "",
                "type": "path",
                "description": "Name of the custom report"
              }
            ]
          },
          "docs": "Retrieve metadata about a report including available output fields, field data types, and prompt parameters that can be used for filtering. Useful for discovering the structure of a report before executing it, and for building dynamic integrations that adapt to report schema changes."
        }
      ]
    }
  ],
  "bundled": true
}