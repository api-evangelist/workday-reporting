          "request": {
            "name": "Workday Reporting Get report field metadata",
            "description": {
              "content": "Retrieve metadata about a report including available output fields, field data types, and prompt parameters that can be used for filtering. Useful for discovering the structure of a report before executing it, and for building dynamic integrations that adapt to report schema changes.",
