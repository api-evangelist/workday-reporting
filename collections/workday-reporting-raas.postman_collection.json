    {
      "id": "219cb57c-2394-4330-8a13-37056f0f4882",
      "name": "Reports",
      "description": {
        "content": "Execute and retrieve data from custom and standard Workday reports configured as web services",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3d0225b9-e2c6-415d-b769-5e8b2840fae0",
          "name": "Workday Reporting Get report data",
          "request": {
            "name": "Workday Reporting Get report data",
            "description": {
              "content": "Execute a Workday custom report and retrieve its data. The report must have web service enabled in its report definition. Returns data in JSON format by default, with support for CSV, XML, and GData formats via the format parameter. Supports prompt-based filtering through query parameters that match the report prompt names configured in Workday. Pagination is supported through limit and offset parameters for large result sets.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":reportOwner",
                ":reportName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format for the report data. Determines the Content-Type of the response body."
                },
                {
                  "disabled": false,
                  "key": "Employee_ID",
                  "value": "<string>",
                  "description": "Example prompt parameter for filtering by Employee ID. Actual parameters depend on the prompts configured in the report definition."
                },
                {
                  "disabled": false,
                  "key": "Effective_Date",
                  "value": "<date>",
                  "description": "Example prompt parameter for filtering by effective date in YYYY-MM-DD format. Actual parameters depend on the prompts configured in the report definition."
                },
                {
                  "disabled": false,
                  "key": "Organization",
                  "value": "<string>",
                  "description": "Example prompt parameter for filtering by organization WID or reference ID. Actual parameters depend on the prompts configured in the report definition."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of rows to return per page"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of rows to skip for pagination"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reportOwner",
                  "description": "(Required) Username of the report owner in Workday, typically the integration system user (ISU) account that owns the report"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reportName",
                  "description": "(Required) Name of the custom report as defined in Workday. Must match the report name exactly, using underscores in place of spaces."
                },
                {
                  "description": "Workday tenant name",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
