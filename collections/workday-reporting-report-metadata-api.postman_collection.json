          "name": "Workday Reporting Get report field metadata",
          "request": {
            "name": "Workday Reporting Get report field metadata",
            "description": {
              "content": "Retrieve metadata about a report including available output fields, field data types, and prompt parameters that can be used for filtering. Useful for discovering the structure of a report before executing it, and for building dynamic integrations that adapt to report schema changes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":reportOwner",
                ":reportName",
                "fields"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reportOwner",
                  "description": "(Required) Username of the report owner"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reportName",
                  "description": "(Required) Name of the custom report"
                },
                {
                  "description": "Workday tenant name",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                }
              ]
            },
