  "info": {
    "_postman_id": "33341863-afa5-4d41-8b81-02f9d3ed21eb",
    "name": "Workday Reporting Workday Report-as-a-Service (RaaS) Report Metadata API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for accessing Workday custom and standard reports as RESTful web services. Enables external systems to consume report data in JSON, CSV, or XML formats. Reports must be configured as Advanced type reports with web service enabled in Workday before they can be accessed through this API. Supports prompt-based filtering through query parameters matching report prompt names configured in the report definition.\n\nContact Support:\n Name: Workday Support\n Email: support@workday.com",
      "type": "text/plain"
    }
  }
